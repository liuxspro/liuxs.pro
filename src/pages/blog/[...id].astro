---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { ArrowLeft } from "@lucide/astro";
import Layout from "@layouts/Layout.astro";
import Prose from "@components/Prose.astro";
import Toc from "@components/Toc.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = (headings ?? []).filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

<Layout title={`${post.data.title} · Liuxspro`}>
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-[minmax(0,1fr)] gap-8 px-6 py-8 sm:px-8 xl:grid-cols-[12rem_minmax(0,1fr)_12rem] xl:gap-6"
  >
    <div class="hidden xl:block" aria-hidden="true"></div>

    <article class="mx-auto w-full min-w-0 max-w-3xl">
      <a
        href="/blog"
        class="mb-6 inline-flex items-center gap-1.5 text-sm text-gray-500 transition-colors hover:text-gray-800 dark:hover:text-gray-200"
      >
        <ArrowLeft class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
        返回文章列表
      </a>

      <h1 class="text-3xl font-bold">{post.data.title}</h1>
      <time
        class="mt-2 block text-sm text-gray-500"
        datetime={post.data.date.toISOString()}
      >
        {post.data.date.toLocaleDateString("zh-CN")}
      </time>

      {post.data.description && (
        <p class="mt-3 text-gray-600 dark:text-gray-400">
          {post.data.description}
        </p>
      )}

      {tocHeadings.length > 0 && (
        <details class="mt-6 rounded-lg border border-gray-200 px-4 py-3 xl:hidden dark:border-gray-700">
          <summary class="cursor-pointer text-sm font-semibold">目录</summary>
          <div class="mt-3">
            <Toc headings={tocHeadings} sticky={false} />
          </div>
        </details>
      )}

      <div class="mt-8">
        <Prose>
          <Content />
        </Prose>
      </div>
    </article>

    {tocHeadings.length > 0 && (
      <aside class="hidden xl:block xl:pl-6">
        <Toc headings={tocHeadings} />
      </aside>
    )}
  </div>
</Layout>
