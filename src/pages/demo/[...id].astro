---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Prose from "@components/Prose.astro";
import Toc from "@components/Toc.astro";

export async function getStaticPaths() {
  const posts = await getCollection("demo");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"demo">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = (headings ?? []).filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

<Layout>
  <div class="mx-auto grid w-full max-w-7xl grid-cols-[minmax(0,1fr)] gap-8 px-6 py-8 sm:px-8 xl:grid-cols-[12rem_minmax(0,1fr)_12rem] xl:gap-6">
    <div class="hidden xl:block" aria-hidden="true"></div>

    <article class="mx-auto w-full min-w-0 max-w-3xl">
      <h1 class="mb-6 text-3xl font-bold">{post.data.title}</h1>

      {tocHeadings.length > 0 && (
        <details class="mb-6 rounded-lg border border-gray-200 px-4 py-3 xl:hidden dark:border-gray-700">
          <summary class="cursor-pointer text-sm font-semibold">目录</summary>
          <div class="mt-3">
            <Toc headings={tocHeadings} sticky={false} />
          </div>
        </details>
      )}

      <Prose>
        <Content />
      </Prose>
    </article>

    {tocHeadings.length > 0 && (
      <aside class="hidden xl:block xl:pl-6">
        <Toc headings={tocHeadings} />
      </aside>
    )}
  </div>
</Layout>
