---
import { ArrowRight } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import Background from "../components/Background.astro";
import icon from "../assets/icon.png";

const links = {
  blog: "/blog",
  github: "https://github.com/liuxspro",
};
---

<Layout>
  <Background />

  <section class="flex grow flex-col items-center justify-center px-6 py-16 text-center">
    <div class="flex w-full max-w-xl flex-col items-center">
      <img
        src={icon.src}
        alt="Liuxs"
        width="144"
        height="144"
        class="reveal h-24 w-24 rounded-2xl border border-gray-200/80 shadow-sm sm:h-28 sm:w-28 dark:border-gray-700"
        style="--reveal-delay: 0ms"
      />

      <p
        class="reveal mt-7 text-xs font-semibold tracking-[0.18em] text-gray-500 uppercase dark:text-gray-400"
        style="--reveal-delay: 60ms"
      >
        liuxs.pro
      </p>

      <p
        class="reveal mt-4 max-w-md text-sm leading-6 text-gray-600 sm:text-base dark:text-gray-400"
        style="--reveal-delay: 180ms"
      >
        写点东西
      </p>

      <div
        class="reveal mt-8 flex flex-wrap items-center justify-center gap-2.5"
        style="--reveal-delay: 240ms"
      >
        <a
          href={links.blog}
          class="inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
        >
          阅读博客
          <ArrowRight class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
        </a>
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white/60 px-5 py-2.5 text-sm font-semibold text-gray-800 backdrop-blur transition-colors hover:border-gray-400 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400 dark:border-gray-700 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .reveal {
    animation: fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--reveal-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }
</style>
