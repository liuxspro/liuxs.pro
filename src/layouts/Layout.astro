---
import "../styles/global.css";
import Nav from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import icon from "../assets/icon.png";

interface Props {
  title?: string;
}

const { title = "Liuxspro" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={icon.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div id="container">
      <header>
        <Nav />
      </header>
      <main class="flex grow flex-col items-stretch min-w-0">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  #container {
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
  }
</style>
