---
import "../styles/global.css";
import Nav from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import icon from "../assets/icon.png";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href={icon.src} />
        <meta name="generator" content={Astro.generator} />
        <title>Liuxspro</title>
    </head>
    <body>
        <div id="container">
            <header>
                <Nav />
            </header>
            <main class="flex grow flex-col items-stretch">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
    #container {
        height: 100%;
        display: grid;
        grid-template-rows: auto 1fr auto;
    }
</style>
